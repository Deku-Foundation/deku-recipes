{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deku-foundation.github.io/schemas/recipe-v1.schema.json",
  "title": "Deku Recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "summary", "license", "source", "architectures", "dependencies"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]{0,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "summary": {"type": "string", "minLength": 1, "maxLength": 300},
    "license": {"type": "string", "minLength": 1, "maxLength": 128},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision", "sha256"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["x86_64", "aarch64"]}
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]{0,127}$"}
    },
    "homepage": {"type": "string", "format": "uri", "pattern": "^https://"},
    "notes": {"type": "string", "maxLength": 4000}
  }
}
